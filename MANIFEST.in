include README.md
include LICENSE
include pyproject.toml
# Every target the README still names by relative path is included here, so a
# reader who opens the sdist's README finds what it names rather than a dead
# link. assets/logo.png and non_factual/ are deliberately not: a 2 MB hero image
# is paid for by every download, and a quarantine notice has no business in a
# distribution — both are referenced by absolute URL from the README instead.
include CHANGELOG.md
include CONTRIBUTING.md
recursive-include docs *.md
recursive-include skills *.md
# Named rather than swept: `recursive-include .github *.md` also carried the pull
# request template and the security-report template into the distribution, and
# the README points at neither.
include .github/WORKFLOWS.md
recursive-include src *.py
recursive-include src *.typed
exclude tests/*
exclude *.pyc
exclude __pycache__/*
global-exclude *.pyc
global-exclude __pycache__/*