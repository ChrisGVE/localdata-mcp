{
  "name": "localdata-mcp",
  "version": "3.0.0-dev",
  "description": "SQL over local data files and SQLite databases. Every datasource becomes a database addressed by a nickname, so a spreadsheet and a database join in one statement.",
  "author": {
    "name": "Christian C. Berclaz",
    "email": "christian.berclaz@mac.com"
  },
  "homepage": "https://github.com/ChrisGVE/localdata-mcp",
  "repository": "https://github.com/ChrisGVE/localdata-mcp",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "sql",
    "sqlite",
    "csv",
    "data"
  ],
  "skills": [
    "./skills/data/"
  ],
  "mcpServers": {
    "localdata": {
      "command": "uvx",
      "args": ["localdata-mcp"],
      "env": {}
    }
  }
}
